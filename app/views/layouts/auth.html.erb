<%# Centered card for signing in, password reset and invitations. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <%= render "layouts/shared/head" %>

  <body class="flex min-h-full flex-col items-center justify-center px-4 py-12">
    <%= render "layouts/shared/logo" %>

    <div class="card mt-8 w-full max-w-md">
      <div class="card-body sm:p-8">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </div>

    <% if locale_switchable? %>
      <div class="mt-6"><%= render "shared/locale_switcher" %></div>
    <% end %>
  </body>
</html>
