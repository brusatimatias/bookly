<%# Public layout: landing page, business pages and the user's business list. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <%= render "layouts/shared/head" %>

  <body class="flex min-h-full flex-col">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <%= render "layouts/shared/logo" %>

        <div class="flex items-center gap-2 sm:gap-4">
          <% if locale_switchable? %>
            <%= render "shared/locale_switcher" %>
          <% end %>

          <% if authenticated? %>
            <% if Current.user.platform_admin? %>
              <%= link_to t(".platform"), platform_root_path, class: "btn-ghost btn-sm" %>
            <% end %>
            <%= link_to t(".dashboard"), dashboard_path, class: "btn-ghost btn-sm" %>
            <span class="hidden items-center gap-2 text-sm text-gray-700 sm:flex">
              <span class="avatar size-8 text-xs"><%= initials(Current.user.name) %></span>
              <%= Current.user.name %>
            </span>
            <%= button_to session_path, method: :delete, class: "btn-ghost btn-sm", title: t(".sign_out") do %>
              <%= icon "logout", class: "size-4" %>
              <span class="sr-only sm:not-sr-only"><%= t(".sign_out") %></span>
            <% end %>
          <% elsif Current.business.nil? %>
            <%# The sign in link stays off the pages that face a business's customers. %>
            <%= link_to t(".sign_in"), new_session_path, class: "btn-secondary btn-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="border-t border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-6 text-sm text-gray-500 sm:px-6">
        <p><%= Current.business ? t(".powered_by") : t(".footer", year: Date.current.year) %></p>
      </div>
    </footer>
  </body>
</html>
