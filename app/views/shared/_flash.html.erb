<%# Flash messages. Alerts are errors or denials; notices confirm an action. %>
<% { alert: [ "exclamation-circle", "bg-red-50 text-red-800 ring-red-600/20", "text-red-500" ],
     notice: [ "check-circle", "bg-green-50 text-green-800 ring-green-600/20", "text-green-500" ] }.each do |type, (icon_name, box, icon_color)| %>
  <% if (message = flash[type]).present? %>
    <div id="<%= type %>" role="<%= type == :alert ? "alert" : "status" %>"
         class="mb-6 flex items-start gap-3 rounded-lg p-4 text-sm font-medium ring-1 ring-inset <%= box %>">
      <%= icon icon_name, class: icon_color %>
      <p><%= message %></p>
    </div>
  <% end %>
<% end %>
