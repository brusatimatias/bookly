<header class="border-b border-gray-200">
  <div class="container mx-auto px-5 py-3 flex items-center justify-between gap-4">
    <%= link_to t("app_name"), root_path, class: "font-bold text-lg text-gray-900" %>

    <div class="flex items-center gap-4 text-sm">
      <%# Business pages are shown in the business's language and face its customers,
          so the language switcher and the sign in link only appear elsewhere. %>
      <% if Current.business.nil? %>
        <%= render "shared/locale_switcher" %>
      <% end %>

      <% if authenticated? %>
        <span class="text-gray-600"><%= Current.user.name %></span>
        <%= button_to t(".sign_out"), session_path, method: :delete, class: "text-gray-700 underline hover:no-underline cursor-pointer" %>
      <% elsif Current.business.nil? %>
        <%= link_to t(".sign_in"), new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      <% end %>
    </div>
  </div>
</header>
