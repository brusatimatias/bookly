<p><%= t(".greeting") %></p>

<p><%= t(".body", inviter: @invitation.invited_by.name, business: @business.name, role: Invitation.human_attribute_name("role.#{@invitation.role}").downcase) %></p>

<p><%= link_to t(".accept"), invitation_url(@invitation.generate_token_for(:acceptance)) %></p>

<p><%= t(".expires", date: l(@invitation.expires_at.in_time_zone(@business.time_zone), format: :long)) %></p>

<p><%= t(".ignore") %></p>
