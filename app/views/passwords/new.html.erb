<% content_for :title, t(".title") %>

<div class="mx-auto md:w-1/2 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>
  <p class="mt-2 text-gray-600"><%= t(".instructions") %></p>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :email_address, t(".email_address"), class: "font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="sm:flex sm:items-center sm:gap-4">
      <%= form.submit t(".submit"), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to t(".back"), new_session_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
