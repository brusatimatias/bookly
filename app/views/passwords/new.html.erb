<% content_for :title, t(".title") %>

<h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
<p class="mt-2 text-sm text-gray-600"><%= t(".instructions") %></p>

<%= form_with url: passwords_path, class: "mt-6 space-y-5" do |form| %>
  <div class="field">
    <%= form.label :email_address, t(".email_address"), class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>

  <%= form.submit t(".submit"), class: "btn-primary btn-block" %>
<% end %>

<p class="mt-6 text-center text-sm">
  <%= link_to t(".back"), new_session_path, class: "link" %>
</p>
