<% content_for :title, t(".title") %>

<h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>

<%= form_with url: session_url, class: "mt-6 space-y-5" do |form| %>
  <div class="field">
    <%= form.label :email_address, t(".email_address"), class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>

  <div class="field">
    <div class="flex items-center justify-between">
      <%= form.label :password, t(".password"), class: "label" %>
      <%= link_to t(".forgot_password"), new_password_path, class: "link text-sm" %>
    </div>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
  </div>

  <%= form.submit t(".submit"), class: "btn-primary btn-block" %>
<% end %>
