<% content_for :title, @business.name %>

<section class="mx-auto max-w-3xl space-y-6">
  <div class="card card-body flex flex-col gap-6 sm:flex-row sm:items-center">
    <% if @business.logo.attached? %>
      <%= image_tag @business.logo, alt: "", class: "h-16 max-w-40 shrink-0 self-start object-contain sm:self-center" %>
    <% else %>
      <span class="avatar size-16 text-xl"><%= initials(@business.name) %></span>
    <% end %>
    <div class="min-w-0">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900"><%= @business.name %></h1>

      <% if @business.address.present? || @business.contact_phone.present? || @business.contact_email.present? %>
        <dl class="mt-3 flex flex-col gap-2 text-sm text-gray-600 sm:flex-row sm:flex-wrap sm:gap-x-6">
          <% if @business.address.present? %>
            <div class="flex items-center gap-1.5">
              <dt><%= icon "map-pin", class: "size-4 text-gray-400" %><span class="sr-only"><%= Business.human_attribute_name(:address) %></span></dt>
              <dd><%= @business.address %></dd>
            </div>
          <% end %>
          <% if @business.contact_phone.present? %>
            <div class="flex items-center gap-1.5">
              <dt><%= icon "phone", class: "size-4 text-gray-400" %><span class="sr-only"><%= t(".phone") %></span></dt>
              <dd><%= link_to @business.contact_phone, "tel:#{@business.contact_phone.delete(" -")}", class: "link" %></dd>
            </div>
          <% end %>
          <% if @business.contact_email.present? %>
            <div class="flex items-center gap-1.5">
              <dt><%= icon "envelope", class: "size-4 text-gray-400" %><span class="sr-only"><%= t(".email") %></span></dt>
              <dd><%= mail_to @business.contact_email, class: "link" %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </div>
    <% if @services.any? %>
      <%= link_to new_booking_path, class: "btn-primary shrink-0 sm:ml-auto" do %>
        <%= icon "calendar", class: "size-5" %> <%= t(".book_appointment") %>
      <% end %>
    <% end %>
  </div>

  <% if @services.any? %>
    <section aria-labelledby="services">
      <h2 id="services" class="mb-4 text-lg font-semibold text-gray-900"><%= t(".services") %></h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <% @services.each do |service| %>
          <article class="card card-body flex flex-col gap-3" id="<%= dom_id(service) %>">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-semibold text-gray-900"><%= service.name %></h3>
              <span class="shrink-0 font-semibold text-brand-700"><%= format_price(service.price_cents) %></span>
            </div>
            <p class="inline-flex items-center gap-1 text-sm text-gray-500"><%= icon "clock", class: "size-4" %><%= format_duration(service.duration_minutes) %></p>
            <% if service.description.present? %>
              <div class="text-sm text-gray-600"><%= service.description %></div>
            <% end %>
            <%= link_to t(".book"), new_booking_path(service_id: service.id), class: "btn-secondary btn-sm mt-auto self-start" %>
          </article>
        <% end %>
      </div>
    </section>
  <% else %>
    <%= render "shared/empty_state", icon: "tag", title: t(".no_services"), message: t(".no_services_hint") %>
  <% end %>

  <% if @professionals.any? %>
    <section aria-labelledby="professionals">
      <h2 id="professionals" class="mb-4 text-lg font-semibold text-gray-900"><%= t(".professionals") %></h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <% @professionals.each do |professional| %>
          <article class="card card-body flex items-center gap-4" id="<%= dom_id(professional) %>">
            <%= professional_avatar(professional, size: "size-14") %>
            <div class="min-w-0 flex-1">
              <h3 class="truncate font-semibold text-gray-900"><%= professional.name %></h3>
              <p class="text-sm text-gray-500"><%= professional.services.select(&:active?).map(&:name).sort_by(&:downcase).to_sentence %></p>
            </div>
            <%= link_to t(".book"), new_booking_path(professional_id: professional.id), class: "btn-secondary btn-sm shrink-0" %>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</section>
