<% content_for :title, t(".title") %>

<div class="mx-auto max-w-2xl">
  <%= render "shared/page_header", title: t(".title"), subtitle: t(".subtitle") %>

  <div class="space-y-6">
    <%= render "admin/appointments/card", appointment: @appointment %>
    <% if @appointment.rescheduled_from %>
      <div class="flex items-start gap-3 rounded-lg bg-yellow-50 p-4 text-sm text-yellow-800 ring-1 ring-yellow-600/20 ring-inset">
        <%= icon "exclamation-circle", class: "mt-0.5 size-5 shrink-0 text-yellow-600" %>
        <p><%= t(".rescheduled") %></p>
      </div>
    <% end %>
    <%= render "admin/appointments/reason_form", event: @event, scope: :rejection,
          url: admin_appointment_rejection_path(@appointment), submit: t(".submit") %>
  </div>
</div>
