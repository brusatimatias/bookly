<%= form_with model: professional, url: (professional.new_record? ? admin_professionals_path : admin_professional_path(professional)), class: "card card-body space-y-5" do |form| %>
  <%= render "shared/form_errors", record: professional %>

  <div class="flex items-center gap-5">
    <%= professional_avatar(professional, size: "size-16") %>
    <div class="field min-w-0 flex-1">
      <%= form.label :photo, class: "label" %>
      <%= form.file_field :photo, accept: Professional::PHOTO_CONTENT_TYPES.join(","),
            class: "block w-full text-sm text-gray-600 file:mr-3 file:cursor-pointer file:rounded-lg file:border-0 file:bg-brand-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-brand-700 hover:file:bg-brand-100" %>
      <p class="hint"><%= t(".photo_hint", size: Professional::PHOTO_MAX_SIZE / 1.megabyte) %></p>
    </div>
  </div>

  <div class="field">
    <%= form.label :name, class: "label" %>
    <%= form.text_field :name, autofocus: professional.new_record?, class: "input" %>
    <p class="hint"><%= t(".name_hint") %></p>
  </div>

  <div class="field">
    <%= form.label :user_id, t(".user"), class: "label" %>
    <%= form.select :user_id, @members.map { |user| [ "#{user.name} (#{user.email_address})", user.id ] },
          { include_blank: t(".no_user") }, class: "input" %>
    <p class="hint"><%= t(".user_hint") %></p>
  </div>

  <fieldset class="field">
    <legend class="label"><%= Professional.human_attribute_name(:services) %></legend>
    <% if @services.any? %>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <%= form.collection_check_boxes :service_ids, @services, :id, :name do |box| %>
          <%= box.label class: "flex cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 ring-1 ring-gray-200 ring-inset hover:bg-gray-50 has-checked:bg-brand-50 has-checked:ring-brand-600/40" do %>
            <%= box.check_box class: "size-4 rounded border-gray-300 text-brand-600 accent-brand-600" %>
            <span class="min-w-0 flex-1 text-sm">
              <span class="block truncate font-medium text-gray-900"><%= box.object.name %></span>
              <span class="text-gray-500"><%= format_duration(box.object.duration_minutes) %> · <%= format_price(box.object.price_cents) %></span>
            </span>
            <% unless box.object.active? %>
              <span class="badge-gray"><%= t(".inactive_service") %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <p class="hint"><%= t(".services_hint") %></p>
    <% else %>
      <p class="hint"><%= t(".no_services_html", link: link_to(t(".create_services"), new_admin_service_path, class: "link")) %></p>
    <% end %>
  </fieldset>

  <div class="flex items-center justify-end gap-3 border-t border-gray-100 pt-5">
    <%= link_to t(".cancel"), admin_professionals_path, class: "btn-ghost" %>
    <%= form.submit t(professional.new_record? ? ".create" : ".update"), class: "btn-primary" %>
  </div>
<% end %>
