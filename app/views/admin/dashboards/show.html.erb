<% content_for :title, t(".title", business: Current.business.name) %>

<%= render "shared/page_header", title: t(".heading", name: Current.user.name), subtitle: t(".subtitle", business: Current.business.name) %>

<% if Current.membership.manager? %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to admin_team_path, class: "card card-body flex items-center gap-4 transition hover:ring-brand-600/40" do %>
      <span class="flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600"><%= icon "users", class: "size-6" %></span>
      <div>
        <p class="text-sm text-gray-600"><%= t(".members") %></p>
        <p class="text-2xl font-bold text-gray-900"><%= @members_count %></p>
      </div>
    <% end %>
    <%= link_to admin_team_path, class: "card card-body flex items-center gap-4 transition hover:ring-brand-600/40" do %>
      <span class="flex size-12 items-center justify-center rounded-lg bg-yellow-50 text-yellow-600"><%= icon "envelope", class: "size-6" %></span>
      <div>
        <p class="text-sm text-gray-600"><%= t(".pending_invitations") %></p>
        <p class="text-2xl font-bold text-gray-900"><%= @pending_invitations_count %></p>
      </div>
    <% end %>
    <%= link_to admin_services_path, class: "card card-body flex items-center gap-4 transition hover:ring-brand-600/40" do %>
      <span class="flex size-12 items-center justify-center rounded-lg bg-green-50 text-green-600"><%= icon "tag", class: "size-6" %></span>
      <div>
        <p class="text-sm text-gray-600"><%= t(".active_services") %></p>
        <p class="text-2xl font-bold text-gray-900"><%= @active_services_count %></p>
      </div>
    <% end %>
    <%= link_to admin_professionals_path, class: "card card-body flex items-center gap-4 transition hover:ring-brand-600/40" do %>
      <span class="flex size-12 items-center justify-center rounded-lg bg-sky-50 text-sky-600"><%= icon "user", class: "size-6" %></span>
      <div>
        <p class="text-sm text-gray-600"><%= t(".active_professionals") %></p>
        <p class="text-2xl font-bold text-gray-900"><%= @active_professionals_count %></p>
      </div>
    <% end %>
  </div>
<% end %>

<div class="card card-body mt-6 flex items-start gap-4">
  <span class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-500"><%= icon "calendar", class: "size-6" %></span>
  <div>
    <p class="font-semibold text-gray-900"><%= t(".coming_soon_title") %></p>
    <p class="mt-1 text-sm text-gray-600"><%= t(".coming_soon") %></p>
  </div>
</div>
