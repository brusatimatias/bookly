<div class="space-y-6">
  <% if @professionals.none? %>
    <%= render "shared/empty_state", icon: "user", title: t(".needs_professional"), message: t(".needs_professional_hint"),
          action: capture { link_to t(".add_professional"), admin_setup_step_path("professional"), class: "btn-primary" } %>
  <% else %>
    <section class="card">
      <h2 class="border-b border-gray-100 px-6 py-4 font-semibold text-gray-900"><%= t(".professionals") %></h2>
      <ul class="list-divided">
        <% @professionals.each do |professional| %>
          <li class="flex items-center gap-3 px-6 py-4 text-sm">
            <span class="avatar"><%= initials(professional.name) %></span>
            <span class="min-w-0 flex-1 truncate font-medium text-gray-900"><%= professional.name %></span>
            <% if professional.working_hours.any? %>
              <%= link_to t(".edit_week"), edit_admin_professional_schedule_path(professional), class: "link shrink-0" %>
            <% else %>
              <span class="badge-yellow shrink-0"><%= t(".without_hours") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <% if @hours.professionals.any? %>
      <%= form_with model: @hours, url: admin_setup_step_path("hours"), method: :patch, class: "card card-body space-y-5" do |form| %>
        <div>
          <h2 class="font-semibold text-gray-900"><%= t(".title") %></h2>
          <p class="mt-1 text-sm text-gray-600"><%= t(".intro", names: @hours.professionals.map(&:name).to_sentence) %></p>
        </div>

        <%= render "shared/form_errors", record: @hours %>

        <fieldset class="field">
          <legend class="label"><%= SetupHours.human_attribute_name(:days) %></legend>
          <div class="mt-1 flex flex-wrap gap-2">
            <% WeeklySchedule::DAYS.each do |day| %>
              <label class="flex cursor-pointer items-center gap-2 rounded-lg px-3 py-2 text-sm ring-1 ring-gray-200 has-checked:bg-brand-50 has-checked:ring-brand-600">
                <%= check_box_tag "setup_hours[days][]", day, @hours.days.include?(day), id: "setup_hours_days_#{day}", class: "size-4 rounded border-gray-300 text-brand-600 accent-brand-600" %>
                <%= t("date.abbr_day_names")[day].capitalize %>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="grid grid-cols-2 gap-5">
          <div class="field">
            <%= form.label :start_time, class: "label" %>
            <%= form.time_field :start_time, required: true, class: "input" %>
          </div>
          <div class="field">
            <%= form.label :end_time, class: "label" %>
            <%= form.time_field :end_time, required: true, class: "input" %>
          </div>
        </div>
        <p class="hint -mt-3"><%= t(".hint") %></p>

        <div class="flex justify-end border-t border-gray-100 pt-5">
          <%= form.submit t(".submit"), class: "btn-primary" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= render "navigation", step: "hours", forward: @setup.hours? %>
