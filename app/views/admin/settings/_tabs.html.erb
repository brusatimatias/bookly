<%# The settings pages: the business's details, its booking rules and its brand. %>
<nav class="-mt-4 mb-6 flex gap-6 border-b border-gray-200 text-sm font-medium" aria-label="<%= t(".label") %>">
  <% [ [ t(".business"), edit_admin_business_path, "businesses" ], [ t(".booking"), edit_admin_settings_path, "settings" ],
        [ t(".branding"), edit_admin_branding_path, "brandings" ] ].each do |label, path, controller| %>
    <% active = controller_name == controller %>
    <%= link_to label, path, "aria-current": (active ? "page" : nil),
          class: [ "-mb-px border-b-2 pb-3 transition-colors",
                   active ? "border-brand-600 text-brand-700" : "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-900" ] %>
  <% end %>
</nav>
