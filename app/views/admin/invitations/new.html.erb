<% content_for :title, t(".title") %>

<section class="w-full max-w-xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-900"><%= t(".title") %></h1>
  <p class="mt-2 text-gray-600"><%= t(".instructions", days: Invitation::VALID_FOR.in_days.to_i) %></p>

  <%= form_with model: @invitation, url: admin_invitations_path, class: "contents" do |form| %>
    <% if @invitation.errors.any? %>
      <ul class="mt-5 py-2 px-3 bg-red-50 text-red-600 rounded-lg" id="errors">
        <% @invitation.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="my-5">
      <%= form.label :email, class: "font-medium" %>
      <%= form.email_field :email, required: true, autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :role, class: "font-medium" %>
      <%= form.select :role, Invitation.roles.keys.map { |role| [ Invitation.human_attribute_name("role.#{role}"), role ] }, {},
            class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="flex items-center gap-4">
      <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to t(".cancel"), admin_team_path, class: "text-gray-700 underline hover:no-underline" %>
    </div>
  <% end %>
</section>
