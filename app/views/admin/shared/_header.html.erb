<header class="border-b border-gray-200 bg-gray-50">
  <div class="container mx-auto px-5 py-3 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      <%= link_to Current.business.name, admin_root_path, class: "font-bold text-lg text-gray-900" %>

      <nav class="flex items-center gap-4 text-sm" aria-label="<%= t(".navigation") %>">
        <%= link_to t(".home"), admin_root_path, class: "text-gray-700 hover:text-gray-900" %>
        <%= link_to t(".public_page"), business_path(Current.business), class: "text-gray-700 hover:text-gray-900" %>
      </nav>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <span class="text-gray-600">
        <%= Current.user.name %> · <%= Membership.human_attribute_name("role.#{Current.membership.role}") %>
      </span>
      <%= link_to t(".my_businesses"), dashboard_path, class: "text-gray-700 underline hover:no-underline" %>
      <%= button_to t(".sign_out"), session_path, method: :delete, class: "text-gray-700 underline hover:no-underline cursor-pointer" %>
    </div>
  </div>
</header>
