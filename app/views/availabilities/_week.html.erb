<%# A week of free start times, Monday first:
      render "availabilities/week", availability:, days:, week:
    Days outside the booking window, or without free times, say why. Pass
    slot_url: ->(slot) { ... } to make each time a link. %>
<% slot_url = local_assigns[:slot_url] %>
<ol class="grid gap-3 lg:grid-cols-7">
  <% (week..(week + 6)).each do |date| %>
    <% slots = days.fetch(date, []) %>
    <li class="card p-4 lg:p-3 <%= "bg-gray-50/60 shadow-none" if slots.empty? %>">
      <p class="text-sm font-semibold <%= slots.any? ? "text-gray-900" : "text-gray-500" %>">
        <%= l(date, format: :weekday) %>
        <% if date == availability.now.to_date %>
          <span class="badge-brand ml-1"><%= t("availabilities.week.today") %></span>
        <% end %>
      </p>
      <% if slots.any? %>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          <% slots.each do |slot| %>
            <% time = l(slot.starts_at, format: :hour) %>
            <% names = slot.professionals.map(&:name).to_sentence %>
            <li>
              <% if slot_url %>
                <%= link_to time, slot_url.call(slot), title: names, class: "inline-block rounded-md bg-brand-50 px-2 py-1 text-sm font-medium text-brand-700 ring-1 ring-brand-600/10 ring-inset hover:bg-brand-100" %>
              <% else %>
                <span title="<%= names %>" class="inline-block rounded-md bg-brand-50 px-2 py-1 text-sm font-medium text-brand-700 ring-1 ring-brand-600/10 ring-inset"><%= time %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-2 text-sm text-gray-500">
          <% if date < availability.now.to_date %>
            <%= t("availabilities.week.past") %>
          <% elsif !availability.bookable_day?(date) %>
            <%= t("availabilities.week.outside_window") %>
          <% elsif !availability.works_on?(date) %>
            <%= t("availabilities.week.not_working") %>
          <% else %>
            <%= t("availabilities.week.full") %>
          <% end %>
        </p>
      <% end %>
    </li>
  <% end %>
</ol>
