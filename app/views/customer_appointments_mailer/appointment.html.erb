<p style="margin:0 0 16px;font-weight:600;"><%= t("customer_appointments_mailer.greeting", name: @appointment.customer.name) %></p>

<p style="margin:0 0 24px;"><%= @body %></p>

<% if @reason.present? %>
  <div style="margin:0 0 24px;padding:12px 16px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
    <p style="margin:0;font-size:12px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:#6b7280;"><%= t("customer_appointments_mailer.reason", business: @business.name) %></p>
    <p style="margin:4px 0 0;white-space:pre-line;color:#374151;"><%= @reason %></p>
  </div>
<% end %>

<%= render "mailers/appointment", appointment: @appointment %>

<p style="margin:0 0 24px;"><%= email_button(*@button) %></p>

<% if @footer %>
  <p style="margin:0;color:#6b7280;font-size:13px;"><%= @footer %></p>
<% end %>
