<%# The appointment's time, service, professional and the business's address,
  for any email about it. Locals: appointment. %>
<% business = Current.business %>
<% rows = [
     [ t("bookings.summary.time"), format_period(appointment.starts_at, appointment.ends_at), t("shared.week_navigation.time_zone", zone: time_zone_label) ],
     [ Appointment.human_attribute_name(:service), appointment.service.name,
       "#{format_duration(appointment.service.duration_minutes)} · #{format_price(appointment.price_cents)}" ],
     [ Appointment.human_attribute_name(:professional), appointment.professional.name, nil ]
   ] %>
<% rows << [ t(".address"), business.address, nil ] if business.address.present? %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;border:1px solid #e5e7eb;border-radius:8px;">
  <% rows.each_with_index do |(label, value, detail), index| %>
    <tr>
      <td style="padding:12px 16px;<%= "border-top:1px solid #e5e7eb;" unless index.zero? %>">
        <p style="margin:0;font-size:12px;font-weight:500;letter-spacing:0.05em;text-transform:uppercase;color:#6b7280;"><%= label %></p>
        <p style="margin:2px 0 0;font-weight:600;color:#111827;"><%= value %></p>
        <% if detail %>
          <p style="margin:0;font-size:14px;color:#6b7280;"><%= detail %></p>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
